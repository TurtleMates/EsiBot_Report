	numberstyle=\tiny\color{mygray},
	numbers=left,
	numbersep=5pt,
	frame=single,
	framerule=0.3pt,
	rulecolor=\color{black},
	breaklines=true,
	breakatwhitespace=false,
	tabsize=2,
	captionpos=b,
	showstringspaces=false,
	xleftmargin=2em
}

\lstdefinestyle{YAMLStyle}{
	backgroundcolor=\color{backcolour},
	basicstyle=\ttfamily\scriptsize,
	keywordstyle=\bfseries\color{codered},
	commentstyle=\itshape\color{codegreen},
	stringstyle=\color{myorange},
	numberstyle=\tiny\color{mygray},
	numbers=left,
	numbersep=5pt,
	frame=single,
	framerule=0.3pt,
	rulecolor=\color{black},
	breaklines=true,
	tabsize=2,
	captionpos=b,
	showstringspaces=false,
	xleftmargin=2em
}

% ── Shell / Bash commands ────────────────────────────────────────────────────
\lstdefinestyle{BashStyle}{
	backgroundcolor=\color{ShellBg},
	basicstyle=\ttfamily\scriptsize\color{ShellText},
	keywordstyle=\bfseries\color{ShellKeyword},
	commentstyle=\itshape\color{ShellComment},
	stringstyle=\color{ShellString},
	numbers=none,
	frame=l,
	framerule=2.8pt,
	rulecolor=\color{ShellBorder},
	breaklines=true,
	breakatwhitespace=false,
	tabsize=2,
	captionpos=b,
	showstringspaces=false,
	xleftmargin=1.6em,
	xrightmargin=0.6em,
	aboveskip=6pt,
	belowskip=4pt
}

