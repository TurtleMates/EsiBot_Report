\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{notebox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiAccent,
	colbacktitle=EsiAccent,
	coltitle=white,
	fonttitle=\bfseries\small,
	title=Note,
	#1
}
\newtcolorbox{warnbox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiRed,
	colbacktitle=EsiRed,
	coltitle=white,
	fonttitle=\bfseries\small,
	title={Limitation},
	#1
}
\newtcolorbox{conceptbox}[2][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiAccent,
	colbacktitle=EsiBlue,
	coltitle=white,
	fonttitle=\bfseries\small,
	attach boxed title to top left={yshift=-2mm,xshift=4mm},
	boxed title style={colback=EsiBlue,colframe=EsiBlue},
	title={#2},
	#1
}
\newtcolorbox{ecartbox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiRedDark,
	colbacktitle=EsiRedDark,
	coltitle=white,
	fonttitle=\bfseries\small,
	title={Deviation vs. Specifications},
	#1
}

