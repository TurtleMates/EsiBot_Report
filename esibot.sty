%% ── tcolorbox (kept for content boxes: notebox, warnbox, etc.) ──────────────
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{notebox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=richelectricblue,
	colbacktitle=richelectricblue,
	coltitle=white,
	fonttitle=\bfseries\small,
	title=Note,
	#1
}
\newtcolorbox{warnbox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiRed,
	colbacktitle=EsiRed,
	coltitle=white,
	fonttitle=\bfseries\small,
	title={Limitation},
	#1
}
\newtcolorbox{conceptbox}[2][]{
	enhanced,
	colback=EsiGray,
	colframe=richelectricblue,
	colbacktitle=richelectricblue,
	coltitle=white,
	fonttitle=\bfseries\small,
	attach boxed title to top left={yshift=-2mm,xshift=4mm},
	boxed title style={colback=richelectricblue,colframe=richelectricblue},
	title={#2},
	#1
}
\newtcolorbox{ecartbox}[1][]{
	enhanced,
	colback=EsiGray,
	colframe=EsiRedDark,
	colbacktitle=EsiRedDark,
	coltitle=white,
	fonttitle=\bfseries\small,
	title={Deviation vs. Specifications},
	#1
}

%% ── Math ─────────────────────────────────────────────────────────────────────
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{siunitx}
\sisetup{per-mode=symbol, detect-all}
\DeclareSIUnit{\fps}{fps}
\DeclareSIUnit{\rpm}{rpm}
\DeclareSIUnit{\baud}{baud}

%% ── TikZ / pgfplots ─────────────────────────────────────────────────────────
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric,arrows.meta,positioning,fit,calc,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

%% ── Lists ────────────────────────────────────────────────────────────────────
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.5em, itemsep=1pt, parsep=0pt}
\setlist[enumerate]{leftmargin=1.5em, itemsep=1pt, parsep=0pt}

%% ── Glossaries / acronyms ────────────────────────────────────────────────────
\RequirePackage[acronym,toc]{glossaries}
\glsdisablehyper

%% ── Paragraph spacing ───────────────────────────────────────────────────────
\RequirePackage{setspace}
\setstretch{1.02}

%% ── Polyglossia (must be loaded AFTER most packages — bidi requirement) ─────
\RequirePackage{polyglossia}
\setmainlanguage{english}
\setotherlanguage{arabic}
\newfontfamily\arabicfont[Script=Arabic,Scale=1]{Scheherazade}

%% ── Content-level convenience commands (unchanged) ──────────────────────────
\DeclareRobustCommand{\topic}[1]{\textcolor{richelectricblue}{\nolinkurl{#1}}}
\newcommand{\rnode}[1]{\texttt{\textbf{#1}}}
\newcommand{\pkg}[1]{\textsf{\textcolor{richelectricblue}{#1}}}
\newcommand{\hw}[1]{\textsc{#1}}
\newcommand{\file}[1]{\texttt{#1}}
\newcommand{\ros}{ROS\,2}
\newcommand{\esibot}{\textbf{EsiBot}}

