%%  esibot.sty  –  EsiBot Technical Report Style
%%  Restyled to match the ICS-lab template (Dr. Sehad / ESI Algiers)
%%  Content macros preserved; only visual styling changed.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{esibot}[2026/06/21 EsiBot Technical Report Style — ICS template]

%% ── Fonts (XeLaTeX) ──────────────────────────────────────────────────────────
\RequirePackage{fontspec}
\RequirePackage{courier}
\RequirePackage{lmodern}

%% ── Page geometry (template values) ──────────────────────────────────────────
\RequirePackage[
	top=1cm, bottom=2cm,
	right=1.5cm, left=1.5cm,
	footskip=1.2cm,
	headheight=8pt,
	includehead=true
]{geometry}

%% ── Language settings ────────────────────────────────────────────────────────
\RequirePackage{indentfirst}
\hyphenpenalty=10000
\parskip=6pt

%% ── Microtype ────────────────────────────────────────────────────────────────
\RequirePackage{microtype}
\setlength{\emergencystretch}{3em}
\hbadness=10000
\hfuzz=30pt

%% ── Colours ──────────────────────────────────────────────────────────────────
\RequirePackage[dvipsnames]{xcolor}

% Template palette
\definecolor{mygreen}{rgb}{0,0.6,0}
\definecolor{mygray}{rgb}{0.47,0.47,0.33}
\definecolor{myorange}{rgb}{0.8,0.4,0}
\definecolor{mywhite}{rgb}{0.98,0.98,0.98}
\definecolor{myblue}{rgb}{0.01,0.61,0.98}
\definecolor{backcolour}{rgb}{0.96,0.96,0.94}
\definecolor{yellowgreen}{rgb}{0.57,0.82,0.31}
\definecolor{codegreen}{HTML}{3D7A7A}
\definecolor{codered}{HTML}{B00040}
\definecolor{codeblue}{HTML}{0000FF}
\definecolor{richelectricblue}{rgb}{0.03, 0.57, 0.82}

% Legacy palette aliases (used by content macros / tcolorboxes in sections)
\definecolor{EsiRed}{HTML}{CC0000}
\definecolor{EsiRedDark}{HTML}{8C0000}
\definecolor{EsiBlue}{rgb}{0.03, 0.57, 0.82}   % now = richelectricblue
\definecolor{EsiAccent}{rgb}{0.03, 0.57, 0.82}  % same blue for consistency
\definecolor{EsiGray}{HTML}{F5F5F5}
\definecolor{EsiDark}{HTML}{222222}
\definecolor{EsiGreen}{HTML}{2E6B47}
\definecolor{CommentGray}{HTML}{888888}
\definecolor{ShellBg}{HTML}{EEF1F4}
\definecolor{ShellBorder}{HTML}{4A5A6A}
\definecolor{ShellText}{HTML}{1C2025}
\definecolor{ShellComment}{HTML}{7A8A9A}
\definecolor{ShellString}{HTML}{2E6B47}
\definecolor{ShellKeyword}{HTML}{2A4A6A}

%% ── Hyperref ─────────────────────────────────────────────────────────────────
\RequirePackage[
	colorlinks=true,
	linkcolor=EsiBlue,
	citecolor=EsiAccent,
	urlcolor=EsiAccent,
	plainpages=false,
	pdfpagelabels=true,
	bookmarksnumbered=true,
	pdftitle={EsiBot --- Technical Report},
	pdfauthor={EsiBot Team - ESI Algiers},
	pdfsubject={Autonomous Mobile Robot},
	pdfkeywords={ROS2, SLAM, Nav2, Kinect, Raspberry Pi, ESP32-CAM, differential drive}
]{hyperref}
\pdfstringdefDisableCommands{%
	\def\ros{ROS 2}%
	\def\gls#1{#1}%
	\def\topic#1{#1}%
	\def\pkg#1{#1}%
	\def\esibot{EsiBot}%
	\def\texttt#1{#1}%
	\def\textbf#1{#1}%
}

%% ── Headers and footers (template style) ─────────────────────────────────────
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\fancyhf{}
\fancypagestyle{fancy}{
	\setlength{\headwidth}{\textwidth}
	\fancyhead[L]{EsiBot --- Technical Report}
	\fancyhead[R]{2025/2026}
	\fancyfoot[C]{\begin{tcolorbox}[width=\textwidth, colframe=black, colback=white, boxsep=0mm, top=1mm, bottom=1mm, left=2mm, right=2mm, nobeforeafter]
		{\fontsize{6pt}{7pt}\selectfont ESI Academic year 2025--2026, All rights reserved --- IoT / Mobile Robotics Integrative Project}\hfill{\fontsize{8pt}{9pt}\selectfont page \thepage/\pageref{LastPage}}
	\end{tcolorbox}}
	\fancyfoot[R]{}
	\fancyfoot[L]{}
	\renewcommand{\headrulewidth}{0.4pt}
}

\fancypagestyle{plain}{
	\setlength{\headwidth}{\textwidth}
	\fancyhead{}
	\fancyfoot[C]{\begin{tcolorbox}[width=\textwidth, colframe=black, colback=white, boxsep=0mm, top=1mm, bottom=1mm, left=2mm, right=2mm, nobeforeafter]
		{\fontsize{6pt}{7pt}\selectfont ESI Academic year 2025--2026, All rights reserved --- IoT / Mobile Robotics Integrative Project}\hfill{\fontsize{8pt}{9pt}\selectfont page \thepage/\pageref{LastPage}}
	\end{tcolorbox}}
	\fancyfoot[R]{}
	\fancyfoot[L]{}
	\renewcommand{\headrulewidth}{0pt}
}

%% ── Titlesec: chapter / section / subsection ─────────────────────────────────
\RequirePackage{titlesec}
\RequirePackage{tocloft}

\titleclass{\chapter}{straight}   % chapters do NOT force a new page

% Chapter: bold black, with a thick rule below
\titleformat{\chapter}
  {\normalfont\Large\bfseries}
  {}
  {0pt}
  {}
  [{\color{richelectricblue}\vspace{-14pt}\rule{\linewidth}{1.5pt}}]
\titlespacing*{\chapter}{0pt}{4pt}{6pt}

% Section: black number + bold text, thin rule below
\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection.}
  {0.4em}
  {}
  [{\color{richelectricblue}\vspace{-12pt}\rule{\linewidth}{0.6pt}}]
\titlespacing*{\section}{0pt}{6pt}{2pt}

% Subsection: black number, bold text
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}
  {0.5em}
  {}
\titlespacing*{\subsection}{0pt}{4pt}{1pt}

% Subsubsection: black number, italic text
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}
  {\thesubsubsection}
  {0.5em}
  {}
\titlespacing*{\subsubsection}{0pt}{3pt}{1pt}

%% ── Table of Contents (tighter, template style) ─────────────────────────────
\setlength{\cftbeforechapskip}{3pt}
\setlength{\cftbeforesecskip}{0pt}
\renewcommand{\cftdotsep}{2}
\setcounter{tocdepth}{1}

%% ── Tables ───────────────────────────────────────────────────────────────────
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\renewcommand{\arraystretch}{1.05}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

\RequirePackage{etoolbox}
\AtBeginEnvironment{tabularx}{\small}
\AtBeginEnvironment{longtable}{\small}
\AtBeginEnvironment{tabular}{\small}

%% ── Figures / captions ──────────────────────────────────────────────────────
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{wrapfig}
\RequirePackage{subcaption}
\captionsetup{
	font=small,
	labelfont=bf,
	labelsep=period,
	skip=2pt
}

%% ── Code listings (template style) ──────────────────────────────────────────
\RequirePackage{listings}

\lstset{%
  backgroundcolor=\color{backcolour},
  basicstyle=\footnotesize,
  breakatwhitespace=false,
  breaklines=true,
  frame=single,
  captionpos=b,
  commentstyle=\color{codegreen},
  deletekeywords={...},
  escapeinside={\%*}{*)},
  extendedchars=true,
  keepspaces=true,
  keywordstyle=\bfseries\color{codered},
  morekeywords={*,...},
  numbers=left,
  numbersep=5pt,
  numberstyle=\tiny\color{mygray},
  rulecolor=\color{black},
  rulesepcolor=\color{myblue},
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  stringstyle=\color{myorange},
  tabsize=4,
  title=\lstname,
}

